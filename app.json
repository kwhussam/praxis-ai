{
  "expo": {
    "name": "PraxisShield AI",
    "slug": "praxisshield",
    "scheme": "praxisshield",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.praxisshield.app",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PraxisShield prüft ausschließlich technische Metadaten im lokalen Praxisnetz, z. B. Routerdienste und UPnP. Es werden keine Patientendaten, Dateien oder Praxissoftware-Inhalte gelesen.",
        "NSLocationWhenInUseUsageDescription": "iOS benötigt diese Berechtigung, um den verbundenen WLAN-Namen für die lokale Sicherheitsbewertung zu lesen.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "ai.praxisshield.app",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A1628"
      },
      "permissions": [
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "NEARBY_WIFI_DEVICES",
        "CHANGE_WIFI_MULTICAST_STATE",
        "CHANGE_WIFI_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "./plugins/with-ios-metro-localhost-fallback",
      "./plugins/with-network-security-probe",
      "./plugins/with-secure-android-backup",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
