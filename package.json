{
  "name": "praxisshield",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "overrides": {
    "@xmldom/xmldom": "^0.9.11"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test -- --runInBand",
    "test": "jest",
    "test:secrets": "jest --runTestsByPath security/__tests__/secret-exposure.test.ts",
    "test:upgrade-baseline": "jest --runTestsByPath security/__tests__/mobile-upgrade-baseline.test.ts --runInBand",
    "verify:native-config": "node scripts/verify-native-config.mjs",
    "verify:android-release-manifest": "node scripts/verify-android-release-manifest.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:sbom:verify": "node scripts/verify-sbom.mjs build/security/praxisshield.cdx.json",
    "security:sarif:gate": "node scripts/gate-sarif.mjs",
    "security:dependencies": "node scripts/gate-dependencies.mjs",
    "test:unit": "jest lib/security/__tests__",
    "test:worker": "jest workers/hono/__tests__",
    "test:rls": "jest supabase/__tests__ --runInBand",
    "postinstall": "patch-package",
    "workers:dev": "wrangler dev --config workers/hono/wrangler.toml",
    "supabase:types": "supabase gen types typescript --local > lib/api/database.types.ts",
    "e2e:env:up": "bash scripts/e2e/env-up.sh",
    "e2e:env:down": "bash scripts/e2e/env-down.sh",
    "e2e:app:ios": "bash scripts/e2e/app-start.sh ios run",
    "e2e:app:android": "bash scripts/e2e/app-start.sh android run",
    "e2e:metro:ios": "bash scripts/e2e/app-start.sh ios start",
    "e2e:metro:android": "bash scripts/e2e/app-start.sh android start",
    "e2e:rls": "bash scripts/e2e/run-rls.sh",
    "e2e:maestro:check": "bash scripts/e2e/maestro.sh --version",
    "e2e:smoke": "bash scripts/e2e/smoke.sh ios",
    "e2e:smoke:android": "bash scripts/e2e/smoke.sh android",
    "e2e:pdf:ios": "bash scripts/e2e/smoke.sh ios pdf",
    "e2e:pdf:android": "bash scripts/e2e/smoke.sh android pdf"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.9.0 <11"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@noble/ciphers": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.2",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "hono": "^4.6.3",
    "lucide-react-native": "^0.577.0",
    "moti": "^0.29.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "react-native-wifi-reborn": "^4.13.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3",
    "wrangler": "^4.119.0"
  }
}
