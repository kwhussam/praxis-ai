{
  "name": "praxisshield",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "overrides": {
    "@xmldom/xmldom": "^0.9.11"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test -- --runInBand",
    "test": "jest",
    "test:secrets": "jest --runTestsByPath security/__tests__/secret-exposure.test.ts",
    "test:upgrade-baseline": "jest --runTestsByPath security/__tests__/mobile-upgrade-baseline.test.ts --runInBand",
    "verify:native-config": "node scripts/verify-native-config.mjs",
    "verify:android-release-manifest": "node scripts/verify-android-release-manifest.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:sbom:verify": "node scripts/verify-sbom.mjs build/security/praxisshield.cdx.json",
    "security:sarif:gate": "node scripts/gate-sarif.mjs",
    "security:dependencies": "node scripts/gate-dependencies.mjs",
    "test:unit": "jest lib/security/__tests__",
    "test:worker": "jest workers/hono/__tests__",
    "test:rls": "jest supabase/__tests__ --runInBand",
    "postinstall": "node scripts/apply-vendor-hardening.mjs",
    "workers:dev": "wrangler dev --config workers/hono/wrangler.toml",
    "supabase:types": "supabase gen types typescript --local > lib/api/database.types.ts",
    "e2e:env:up": "bash scripts/e2e/env-up.sh",
    "e2e:env:down": "bash scripts/e2e/env-down.sh",
    "e2e:app:ios": "bash scripts/e2e/app-start.sh ios run",
    "e2e:app:android": "bash scripts/e2e/app-start.sh android run",
    "e2e:metro:ios": "bash scripts/e2e/app-start.sh ios start",
    "e2e:metro:android": "bash scripts/e2e/app-start.sh android start",
    "e2e:rls": "bash scripts/e2e/run-rls.sh",
    "e2e:maestro:check": "bash scripts/e2e/maestro.sh --version",
    "e2e:smoke": "bash scripts/e2e/smoke.sh ios",
    "e2e:smoke:android": "bash scripts/e2e/smoke.sh android",
    "e2e:wlan:ios": "bash scripts/e2e/smoke.sh ios wlan",
    "e2e:pdf:ios": "bash scripts/e2e/smoke.sh ios pdf",
    "e2e:pdf:android": "bash scripts/e2e/smoke.sh android pdf"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.9.0 <11"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.2",
    "expo": "^55.0.30",
    "expo-asset": "~55.0.20",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.39",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-network": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "hono": "^4.6.3",
    "lucide-react-native": "^0.520.0",
    "moti": "^0.29.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-wifi-reborn": "^4.13.5",
    "react-native-worklets": "0.7.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-preset-expo": "~55.0.25",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.119.0"
  },
  "expo": {
    "install": {
      "exclude": []
    }
  }
}
