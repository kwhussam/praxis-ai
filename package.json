{
  "name": "praxisshield",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "overrides": {
    "@xmldom/xmldom": "^0.9.11"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test -- --runInBand",
    "test": "jest",
    "test:secrets": "jest --runTestsByPath security/__tests__/secret-exposure.test.ts",
    "verify:native-config": "node scripts/verify-native-config.mjs",
    "verify:android-release-manifest": "node scripts/verify-android-release-manifest.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:sbom:verify": "node scripts/verify-sbom.mjs build/security/praxisshield.cdx.json",
    "security:sarif:gate": "node scripts/gate-sarif.mjs",
    "security:dependencies": "node scripts/gate-dependencies.mjs",
    "test:unit": "jest lib/security/__tests__",
    "test:worker": "jest workers/hono/__tests__",
    "test:rls": "jest supabase/__tests__ --runInBand",
    "postinstall": "patch-package",
    "workers:dev": "wrangler dev --config workers/hono/wrangler.toml",
    "supabase:types": "supabase gen types typescript --local > lib/api/database.types.ts",
    "e2e:env:up": "bash scripts/e2e/env-up.sh",
    "e2e:env:down": "bash scripts/e2e/env-down.sh",
    "e2e:app:ios": "bash scripts/e2e/app-start.sh ios run",
    "e2e:app:android": "bash scripts/e2e/app-start.sh android run",
    "e2e:metro:ios": "bash scripts/e2e/app-start.sh ios start",
    "e2e:metro:android": "bash scripts/e2e/app-start.sh android start",
    "e2e:rls": "bash scripts/e2e/run-rls.sh",
    "e2e:maestro:check": "bash scripts/e2e/maestro.sh --version",
    "e2e:smoke": "bash scripts/e2e/smoke.sh ios",
    "e2e:smoke:android": "bash scripts/e2e/smoke.sh android",
    "e2e:pdf:ios": "bash scripts/e2e/smoke.sh ios pdf",
    "e2e:pdf:android": "bash scripts/e2e/smoke.sh android pdf"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.9.0 <11"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@noble/ciphers": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^6.1.18",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.2",
    "expo": "~51.0.39",
    "expo-blur": "~13.0.3",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.2",
    "expo-crypto": "~13.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-network": "~6.0.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~1.12.1",
    "hono": "^4.6.3",
    "lucide-react-native": "^0.468.0",
    "moti": "^0.29.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "~4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "react-native-wifi-reborn": "^4.13.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/react": "~18.2.79",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "patch-package": "^8.0.1",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.9.3",
    "wrangler": "^4.119.0"
  }
}
