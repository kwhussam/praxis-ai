  "riskRegister": [
    {
      "id": "custom_network_probe_bridge",
      "severity": "high",
      "status": "ios_interop_proven_android_device_proof_deferred",
      "packages": [
        "react-native"
      ],
      "reason": "Persisted measured TCP and SSDP evidence proves the Swift/Objective-C legacy bridge through the New Architecture interop layer on an iOS simulator, now on React Native 0.85. Runtime proof for the Kotlin bridge remains deferred to the physical Android device gate."
