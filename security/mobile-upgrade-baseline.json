        "expo-crypto",
        "expo-secure-store",
        "expo-sqlite"
      ],
      "reason": "Any regression can expose or make tenant-bound inventory and credentials unavailable."
    },
    {
      "id": "file_and_pdf_lifecycle",
      "severity": "high",
      "status": "legacy_api_still_exported_migration_deferred_to_sdk57",
      "packages": [
        "expo-file-system",
        "expo-sharing"
      ],
      "reason": "SDK 56 makes copy() and move() asynchronous, but PraxisShield calls neither and reads the PDF cache through the still-exported expo-file-system/legacy entry point. The migration off the deprecated legacy API remains open for the SDK 57 stage."
    },
    {
      "id": "router_navigation_split",
      "severity": "high",
      "status": "resolved_in_sdk56_router_decoupled",
      "packages": [
        "expo-router",
        "react-native-gesture-handler",
        "react-native-screens"
      ],
      "reason": "SDK 56 decoupled Expo Router from React Navigation; expo-router 56 builds on its own standard-navigation fork. The orphaned @react-navigation/native direct dependency was removed after proving no application module imported it and no other package required it. Expo Doctor's dedicated check now passes."
    },
    {
      "id": "animation_runtime",
      "severity": "high",
      "status": "sdk56_hermes_v1_regression_open_fix_in_sdk57",
      "packages": [
        "moti",
        "react-native-reanimated"
      ],
      "reason": "SDK 56 enables Hermes V1 by default and Expo Doctor confirms the installed Hermes V1 250829098.0.10 is affected by the documented memory regression with react-native-worklets and react-native-reanimated. The fix first ships in Hermes V1 250829098.0.16 / React Native 0.86.2, so it cannot be closed inside SDK 56. This is the reason SDK 56 stays transitional and is not released to production."
    },
    {
      "id": "icon_migration",
      "severity": "medium",
      "status": "explicit_direct_dependency_migration_deferred_to_sdk57",
      "packages": [
        "@expo/vector-icons",
        "expo-font",
        "react-native-svg",
        "lucide-react-native"
      ],
      "reason": "SDK 56 removed @expo/vector-icons from the expo package's own dependencies; PraxisShield already declares it directly, so rendering is unaffected. Migrating to the scoped @react-native-vector-icons packages remains open before the final target."
    },
    {
      "id": "minimum_platform_bump",
      "severity": "high",
      "status": "applied_android24_ios16_4",
      "packages": [
        "react-native",
        "expo-build-properties"
      ],
      "reason": "The migration keeps Android 7/API 24 and raises the iOS deployment target to 16.4, which expo-build-properties enforces fail-closed in SDK 56. Android compileSdk and targetSdk stay at 36."
    }
